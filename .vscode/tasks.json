{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure (Debug)",
      "type": "shell",
      "command": "cmake --preset linux-debug -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "CMake Build (Debug)",
      "type": "shell",
      "command": "cmake --build --preset linux-debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CMake Configure (Debug)"
      ],
      "problemMatcher": [
        "$msCompile",
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
